    },
    {
      "id": "LOAD",
      "title": "Load and contact",
      "terminal": true,
      "success": true,
      "data": {
        "department": {
          "type": "string",
          "__example__": "example"
        },
        "date": {
          "type": "string",
          "__example__": "example"
        },
        "time": {
          "type": "string",
          "__example__": "example"
        },
        "pickup": {
          "type": "string",
          "__example__": "example"
        },
        "drop": {
          "type": "string",
          "__example__": "example"
        },
        "vehicle": {
          "type": "string",
          "__example__": "example"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "TextInput",
                "name": "material",
                "label": "Material / load",
                "input-type": "text",
                "required": true,
                "helper-text": "What is being moved"
              },
              {
                "type": "TextInput",
                "name": "quantity",
                "label": "Quantity",
                "input-type": "number",
                "required": true
              },
              {
                "type": "Dropdown",
                "name": "unit",
                "label": "Unit",
                "required": true,
                "data-source": [
                  {
                    "id": "kg",
                    "title": "kg"
                  },
                  {
                    "id": "lbs",
                    "title": "lbs"
                  },
                  {
                    "id": "tonnes",
                    "title": "tonnes"
                  },
                  {
                    "id": "cartons",
                    "title": "cartons"
                  },
                  {
                    "id": "bags",
                    "title": "bags"
                  },
                  {
                    "id": "pieces",
                    "title": "pieces"
                  },
                  {
                    "id": "pallets",
                    "title": "pallets"
                  },
                  {
                    "id": "litres",
                    "title": "litres"
                  }
                ]
              },
              {
                "type": "TextInput",
                "name": "contact",
                "label": "Contact and phone",
                "input-type": "text",
                "required": true,
                "helper-text": "Name and phone number, for example Ali 0300 1234567"
              },
              {
                "type": "TextArea",
                "name": "instructions",
                "label": "Instructions",
                "required": false,
                "helper-text": "Optional: anything the driver should know"
              },
              {
                "type": "Footer",
                "label": "Send request",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "department": "${data.department}",
                    "date": "${data.date}",
                    "time": "${data.time}",
                    "pickup": "${data.pickup}",
                    "drop": "${data.drop}",
                    "vehicle": "${data.vehicle}",
                    "material": "${form.material}",
                    "quantity": "${form.quantity}",
                    "unit": "${form.unit}",
                    "contact": "${form.contact}",
                    "instructions": "${form.instructions}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
