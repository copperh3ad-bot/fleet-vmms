# Copy to .env.local. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side Postgres connection (Supabase pooled string). Used only by src/lib/db.
DATABASE_URL=
# Email sent by the app, not by Supabase (docs/OPERATIONS.md, "Email"). Any SMTP service works.
SMTP_URL=
EMAIL_FROM=
# The secret Supabase shows when you add the Send Email hook. Looks like v1,whsec_...
AUTH_HOOK_SECRET=
# Supabase's service key: lets the app make logins for people with no email (ADR-025). Server only. Never in the repository.
SUPABASE_SERVICE_ROLE_KEY=
