// Usage: npx tsx scripts/embed-migrations.mts
// Writes src/lib/db/embedded-migrations.ts: every migration file as a string inside the code. The site creates
// organizations at run time, and a serverless function cannot read db/*.sql from disk. Runs before every build
// (npm "prebuild"); a test fails if the committed copy is out of date.
import { writeFileSync } from "node:fs";
import { loadMigrations } from "../src/lib/db/migrate";

const section = (name: string, dir: string) => `export const ${name}: Migration[] = ${JSON.stringify(loadMigrations(dir), null, 2)};\n`;
writeFileSync("src/lib/db/embedded-migrations.ts", `// GENERATED by scripts/embed-migrations.mts. Do not edit. Run \`npx tsx scripts/embed-migrations.mts\` after changing anything in db/.
import type { Migration } from "./migrate";

${section("PLATFORM_MIGRATIONS", "db/public")}
${section("CONTROL_MIGRATIONS", "db/control")}
${section("TENANT_MIGRATIONS", "db/tenant-template")}`);
console.log("embedded migrations written");
